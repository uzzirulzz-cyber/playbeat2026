# ---- PlayBeat Digital — Environment Variables ----
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real .env file — it is gitignored by design.

# Prisma SQLite (used by the scaffold's local db/ folder, optional)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# MongoDB Atlas connection string for the PlayBeat Digital store.
# Replace with your own cluster URI. Format:
#   mongodb+srv://<user>:<password>@<cluster>/<dbname>?appName=<App>
MONGODB_URI=mongodb+srv://YOUR_MONGO_USER:YOUR_MONGO_PASSWORD@your-cluster.mongodb.net/?appName=YourApp
MONGODB_DB=playbeat_store

# Optional: override the admin login credentials checked by the store.
# Defaults to admin@playbeat.digital / playbeat1122 if not set.
# ADMIN_EMAIL=admin@playbeat.digital
# ADMIN_PASSWORD=your-strong-password
